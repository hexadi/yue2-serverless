YUE2_MODEL=m-a-p/YuE2-3B
YUE2_VAE=m-a-p/YuE2-Vae
YUE2_DEVICE=cuda
YUE2_MEMORY_BUDGET_GIB=24
YUE2_BACKEND=torch
YUE2_QUANTIZATION=none
YUE2_OFFLOAD_AR=false

# If a Runpod Network Volume is attached, point this at it to persist downloads:
# HF_HOME=/runpod-volume/huggingface
HF_HOME=/root/.cache/huggingface
YUE2_OUTPUT_DIR=/tmp/yue2-output

# Optional S3-compatible artifact delivery (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=yue2/jobs
S3_URL_TTL_SECONDS=86400
YUE2_CLEANUP_AFTER_UPLOAD=true
YUE2_UPLOAD_ALL_ARTIFACTS=false
